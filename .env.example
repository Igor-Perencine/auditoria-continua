# Copie para .env (ou rode .\setup.ps1, que gera os segredos automaticamente).
# NUNCA versione o arquivo .env.

# --- Banco de dados
POSTGRES_USER=auditoria
POSTGRES_DB=auditoria
POSTGRES_PASSWORD=TROCAR

# --- Segredos da aplicação
JWT_SECRET=TROCAR
# 32 bytes aleatórios em base64 (chave mestra da criptografia das evidências)
MASTER_KEY=TROCAR
MASTER_KEY_VERSION=1
ACCESS_TOKEN_MINUTES=30

# --- Usuários iniciais
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TROCAR
# Cria usuários de demonstração: auditor, gestor, leitura (mesma senha abaixo)
SEED_DEMO_USERS=true
DEMO_PASSWORD=TROCAR

# --- Inteligência artificial: gemini | ollama | none
AI_PROVIDER=none
# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Para Ollama (local): AI_PROVIDER=ollama e suba com --profile ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_PSEUDONYMIZE=true
AI_MAX_PER_CYCLE=5
AI_MIN_INTERVAL_SECONDS=6
AI_CONFIDENCE_THRESHOLD=0.7

# --- Coleta contínua
COLLECT_INTERVAL_MINUTES=5
# simulador | active_directory | wazuh (separados por vírgula)
ENABLED_COLLECTORS=simulador

# --- Active Directory (opcional, experimental)
AD_SERVER=
AD_USE_SSL=true
AD_USER=
AD_PASSWORD=
AD_BASE_DN=

# --- Wazuh (opcional, experimental)
WAZUH_URL=
WAZUH_USER=
WAZUH_PASSWORD=
WAZUH_VERIFY_TLS=false
